# ─── PostgreSQL ───────────────────────────────────────────
# Do NOT keep the placeholder password below. Generate a real one, e.g.:
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
POSTGRES_USER=replica_app
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_REAL_PASSWORD
POSTGRES_DB=replica_ai
POSTGRES_PORT=5432

# Prisma / SQLAlchemy connection string
DATABASE_URL=postgresql://replica_app:CHANGE_ME_GENERATE_A_REAL_PASSWORD@localhost:5432/replica_ai
# Async variant (used by FastAPI)
DATABASE_URL_ASYNC=postgresql+asyncpg://replica_app:CHANGE_ME_GENERATE_A_REAL_PASSWORD@localhost:5432/replica_ai

# ─── Redis ────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ───────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ─── Ollama ───────────────────────────────────────────────
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=mistral:7b-instruct
OLLAMA_REQUEST_TIMEOUT=300

# ─── Next.js (web) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── FastAPI (api) ────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
