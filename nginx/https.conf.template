# ─────────────────────────────────────────────────────────
# Replica AI — HTTPS vhost template
#
# Deliberately NOT in conf.d/ — nginx auto-loads everything there
# via `include /etc/nginx/conf.d/*.conf`, and this block's
# ssl_certificate path doesn't exist until certbot has actually
# issued a certificate. deploy.sh renders this file (substituting
# {{DOMAIN}}) into conf.d/replica-ai-ssl.conf only after that
# succeeds, then reloads nginx. See nginx/conf.d/replica-ai.conf
# for the always-active HTTP vhost this pairs with.
# ─────────────────────────────────────────────────────────

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{DOMAIN}} www.{{DOMAIN}};

    ssl_certificate     /etc/letsencrypt/live/{{DOMAIN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{DOMAIN}}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{DOMAIN}}/chain.pem;

    include /etc/nginx/snippets/security-headers.conf;

    # Per-IP connection cap
    limit_conn conn_limit 50;

    # ─── Auth endpoints (tighter rate limit) ──────────────
    location ~ ^/api/(auth|security/2fa)/ {
        limit_req zone=auth_limit burst=5 nodelay;

        proxy_pass http://replica_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_redirect off;
    }

    # ─── WebSocket endpoints ──────────────────────────────
    location ^~ /ws/ {
        limit_req zone=ws_limit burst=10 nodelay;

        proxy_pass http://replica_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout    3600s;
        proxy_send_timeout    3600s;
        proxy_connect_timeout 75s;
        proxy_buffering       off;
    }

    # ─── REST API ─────────────────────────────────────────
    location /api/ {
        limit_req zone=api_limit burst=50 nodelay;

        proxy_pass http://replica_api;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_redirect off;
    }

    # ─── Next.js static assets (long cache) ───────────────
    location /_next/static/ {
        proxy_pass http://replica_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_cache_valid 200 1y;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location /_next/image {
        proxy_pass http://replica_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    location ~* ^/(favicon\.ico|robots\.txt|manifest\.json|sitemap\.xml)$ {
        proxy_pass http://replica_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    location ~* \.(?:jpg|jpeg|gif|png|webp|svg|ico|woff2?|ttf|otf|eot|css|js)$ {
        proxy_pass http://replica_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }

    # ─── Next.js pages (SSR) ──────────────────────────────
    location / {
        proxy_pass http://replica_web;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_redirect off;
    }

    # ─── Health endpoint (public, no rate limit) ──────────
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
