    "fineTunedResponse": "\u09ab\u09be\u0987\u09a8-\u099f\u09bf\u0989\u09a8 \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be",
