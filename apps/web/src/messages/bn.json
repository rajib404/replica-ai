    "enableAutoTriggerDesc": "\u09aa\u09cd\u09b0\u09a4\u09bf N \u09a8\u09a4\u09c1\u09a8 \u09ae\u09be\u09b2\u09bf\u0995 \u09ac\u09be\u09b0\u09cd\u09a4\u09be\u09b0 \u09aa\u09b0\u09c7 \u098f\u0995\u099f\u09bf \u09a8\u09a4\u09c1\u09a8 \u09ab\u09be\u0987\u09a8-\u099f\u09bf\u0989\u09a8 \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3 \u0995\u09b0\u09c1\u09a8\u0964",
    "autoApprove": "\u09b8\u09cd\u09ac\u09af\u09bc\u0982\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09ad\u09be\u09ac\u09c7 \u0995\u09be\u099c \u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09a8",
    "autoApproveDesc": "\u09ae\u09cd\u09af\u09be\u09a8\u09c1\u09af\u09bc\u09be\u09b2 \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4\u0995\u09b0\u09a3 \u099b\u09be\u09a1\u09bc\u09be\u0987 \u09b8\u09cd\u09ac\u09af\u09bc\u0982\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09ad\u09be\u09ac\u09c7 \u09ab\u09be\u0987\u09a8-\u099f\u09bf\u0989\u09a8\u09bf\u0982 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8\u0964",
    "triggerThreshold": "\u09aa\u09b0\u09ac\u09b0\u09cd\u09a4\u09c0 \u099f\u09cd\u09b0\u09bf\u0997\u09be\u09b0 \u09aa\u09b0\u09cd\u09af\u09a8\u09cd\u09a4 \u09ac\u09be\u09b0\u09cd\u09a4\u09be",
