# Application
DEBUG=false

# Database
# Do NOT keep the placeholder password below. Generate a real one, e.g.:
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
# Use a dedicated least-privilege role, not the Postgres superuser.
DATABASE_URL=postgresql+asyncpg://replica_app:CHANGE_ME_GENERATE_A_REAL_PASSWORD@localhost:5432/replica_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Service
AI_SERVICE_URL=http://localhost:8100

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Google OAuth sign-in
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
WEB_APP_URL=http://localhost:3000

# Auth / JWT
HOST_URL=http://localhost:8000
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CONNECT_TOKEN_EXPIRE_MINUTES=60

# Rate limiting
VERIFY_MAX_ATTEMPTS=3
VERIFY_WINDOW_SECONDS=900
VERIFY_LOCKOUT_SECONDS=3600

# Web Push notifications (VAPID)
# Generate keys with: python -c "from py_vapid import Vapid; v = Vapid(); v.generate_keys(); v.save_key('vapid_private.pem')"
# Then derive base64url encoded keys (see apps/api/CLAUDE.md for full instructions).
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@replica.ai
PUSH_TTL_SECONDS=86400

# Admin dashboard
# Set ADMIN_ENABLED=true to expose /api/admin/* and the /admin web console.
# Generate the bcrypt password hash with:
#   python -c "from app.core.security import hash_secret; print(hash_secret('mypass'))"
# Generate the JWT secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ADMIN_JWT_SECRET MUST be different from JWT_SECRET_KEY so admin and owner
# sessions never share signing material. ADMIN_IP_ALLOWLIST is a comma-separated
# list of CIDR ranges; leave empty to allow all clients.
ADMIN_ENABLED=false
ADMIN_USER=
ADMIN_PASS_HASH=
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRE_MINUTES=60
ADMIN_IP_ALLOWLIST=[]
ADMIN_LOG_BUFFER_SIZE=2000
ADMIN_BACKUP_DIR=./storage/backups
