# ─────────────────────────────────────────────────────────
# Replica AI — production environment template
#
# Copy to .env.production and fill in real secrets:
#   cp .env.production.example .env.production
#
# All secrets MUST be strong random values. Generate with:
#   openssl rand -hex 32      (for JWT/encryption keys)
#   openssl rand -base64 24   (for passwords)
#
# DO NOT commit .env.production to version control.
# DO NOT use these example values in production.
# ─────────────────────────────────────────────────────────

# ─── Public hostname & TLS ───────────────────────────────
DOMAIN=replica.example.com
PUBLIC_BASE_URL=https://replica.example.com
LETSENCRYPT_EMAIL=admin@example.com
NEXT_PUBLIC_API_URL=https://replica.example.com

# ─── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=replica
POSTGRES_PASSWORD=__REPLACE_WITH_openssl_rand_base64_24__
POSTGRES_DB=replica_ai

# ─── Redis ───────────────────────────────────────────────
REDIS_PASSWORD=__REPLACE_WITH_openssl_rand_base64_24__

# ─── Qdrant ──────────────────────────────────────────────
# Optional: set to enable API key auth on Qdrant
QDRANT_API_KEY=

# ─── Application secrets ─────────────────────────────────
# Legacy HS256 fallback (will be removed when RS256 keys are deployed)
JWT_SECRET_KEY=__REPLACE_WITH_openssl_rand_hex_32__

# Fernet base key (32 bytes, base64-friendly)
ENCRYPTION_KEY=__REPLACE_WITH_openssl_rand_hex_16__

# AES-256-GCM master key — losing this means losing all encrypted data
# Back this up in a password manager and a sealed envelope. NO RECOVERY.
ENCRYPTION_MASTER_KEY=__REPLACE_WITH_openssl_rand_hex_32__

# ─── Google Sign-In (optional) ───────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# The redirect URI is derived automatically from PUBLIC_BASE_URL above
# (see docker-compose.prod.yml) — register this exact value in the Cloud
# Console client's "Authorized redirect URIs":
#   https://<your-domain>/api/auth/google/callback
# Leave both blank to disable Google sign-in (falls back to email/password).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Workers ─────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
AI_GUNICORN_WORKERS=2

# ─── Ollama ──────────────────────────────────────────────
OLLAMA_DEFAULT_MODEL=mistral:7b-instruct

# ─── Stripe (optional, for billing) ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ─── External LLM providers (optional, owner-managed) ───
# These are stored encrypted per-owner in the database; no global keys.

# ─── Translation providers (optional) ───────────────────
TRANSLATION_EXTERNAL_API=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# ─── Monitoring ──────────────────────────────────────────
# Webhook called when monitor.sh detects a failure (Slack, Discord, etc.)
ALERT_WEBHOOK_URL=
# Comma-separated emails for alerts (requires `mail` command on host)
ALERT_EMAIL=

# ─── Backups ─────────────────────────────────────────────
BACKUP_DIR=/var/backups/replica-ai
BACKUP_RETENTION_DAYS=30
# Optional offsite copy: rclone remote name (rclone must be configured on host)
BACKUP_RCLONE_REMOTE=
